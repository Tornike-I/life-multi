{$DOMAIN} {
	handle /ws {
		reverse_proxy 127.0.0.1:3001
	}

	handle /health {
		reverse_proxy 127.0.0.1:3001
	}

	handle {
		root * /opt/life-multi/current/apps/client/dist
		encode zstd gzip
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		file_server
	}
}
